APP_NAME="Waifair Shopping Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=info

# Default database (SQLite works out of the box on Railway)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Railway MySQL (auto-detected via MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD, or MYSQL_URL)
# DB_CONNECTION=mysql

# Railway PostgreSQL (auto-detected via PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, or DATABASE_URL)
# DB_CONNECTION=pgsql

CORS_ALLOWED_ORIGINS=https://frontend-waifair-fi6znhsgn-waifairs-ctrl.vercel.app,https://admin-panel-waifair-fpd2t54h5-waifairs-ctrl.vercel.app
RUN_MIGRATIONS=false
